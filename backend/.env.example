# ProposalCraft Backend Environment Variables

PROJECT_NAME=ProposalCraft
PROJECT_VERSION=1.0.0
ENVIRONMENT=development

# Database Connection (PostgreSQL on Render/Production, SQLite for local fallback)
# Local: sqlite:///./proposalcraft.db
# Render PostgreSQL: postgresql://username:password@hostname:5432/dbname
DATABASE_URL=sqlite:///./proposalcraft.db

# Storage Paths
STORAGE_DIR=./storage
UPLOAD_DIR=./storage/uploads
PDF_OUTPUT_DIR=./storage/generated_pdfs

# Security
SECRET_KEY=generate-a-strong-random-secret-key-for-production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://proposalcraft.vercel.app
